digraph G { graph [fontname="Helvetica", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", dpi=200];
node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#1e3a8a", fillcolor="#eef2ff", penwidth=1.2, margin="0.18,0.08"];
edge  [fontname="Helvetica", fontsize=9, color="#475569", arrowsize=0.7]; rankdir=LR; node[shape=plain, style="", fillcolor=""];
 C[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1e3a8a"><tr><td bgcolor="#1e3a8a"><font color="white"><b>CUSTOMER</b></font></td></tr><tr><td align="left">PK customer_id</td></tr><tr><td align="left">full_name, phone, email</td></tr><tr><td align="left">account_status</td></tr></table>>];
 M[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1e3a8a"><tr><td bgcolor="#1e3a8a"><font color="white"><b>SMART_METER</b></font></td></tr><tr><td align="left">PK meter_id</td></tr><tr><td align="left">FK customer_id</td></tr><tr><td align="left">meter_type, communication_status</td></tr></table>>];
 P[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1e3a8a"><tr><td bgcolor="#1e3a8a"><font color="white"><b>PAYMENT_TRANSACTION</b></font></td></tr><tr><td align="left">PK transaction_id (idempotency key)</td></tr><tr><td align="left">FK customer_id</td></tr><tr><td align="left">amount, channel, payment_status</td></tr></table>>];
 L[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1e3a8a"><tr><td bgcolor="#1e3a8a"><font color="white"><b>CREDIT_LOADING</b></font></td></tr><tr><td align="left">PK loading_id</td></tr><tr><td align="left">FK transaction_id, FK meter_id</td></tr><tr><td align="left">credit_value, loading_status</td></tr></table>>];
 A[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#b45309"><tr><td bgcolor="#b45309"><font color="white"><b>AUDIT_LOG</b> (append-only)</font></td></tr><tr><td align="left">PK audit_id</td></tr><tr><td align="left">actor, activity_type, timestamp, result</td></tr></table>>];
 C->P[label="1 : M"]; P->L[label="1 : 1"]; L->M[label="M : 1"]; C->M[label="1 : M"]; P->A[style=dashed, label="every state change"]; L->A[style=dashed];
}
