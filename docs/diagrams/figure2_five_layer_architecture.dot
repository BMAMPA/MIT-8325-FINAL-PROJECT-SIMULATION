digraph G { graph [fontname="Helvetica", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", dpi=200];
node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#1e3a8a", fillcolor="#eef2ff", penwidth=1.2, margin="0.18,0.08"];
edge  [fontname="Helvetica", fontsize=9, color="#475569", arrowsize=0.7]; rankdir=TB; nodesep="0.25";
 L1[label="Layer 1 — Customer Interaction\nMobile app · Bank app / USSD · Web portal · Authorised vendor apps", width=6.2];
 L2[label="Layer 2 — Payment Integration\nPayment gateway / PSP  →  Secure API Gateway (TLS 1.3, rate limiting, JWT check)", width=6.2];
 subgraph cluster3 { label="Layer 3 — Transaction Processing"; fontname="Helvetica-Bold"; style="rounded"; color="#1e3a8a";
   A[label="Authentication\nservice"]; P[label="Payment\nvalidation"]; T[label="Transaction engine\n(idempotency + ownership)"]; B[label="IBEDC billing / CIS\n(tariff band → kWh)"]; A->T; P->T; T->B; }
 L4[label="Layer 4 — Smart Meter Communication\nMeter Management API → encrypted DLMS/COSEM credit command → smart meter → acknowledgement", width=6.2];
 L5[label="Layer 5 — Governance & Security (cross-cutting)\nRBAC · immutable audit log · monitoring / SIEM · RACI accountability", fillcolor="#fef3c7", color="#b45309", width=6.2];
 L1->L2; L2->A; L2->P; B->L4; L4->L5 [style=dashed, label=" audit events"];
}
