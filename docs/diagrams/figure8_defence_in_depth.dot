digraph G { graph [fontname="Helvetica", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", dpi=200];
node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#1e3a8a", fillcolor="#eef2ff", penwidth=1.2, margin="0.18,0.08"];
edge  [fontname="Helvetica", fontsize=9, color="#475569", arrowsize=0.7];
 rankdir=TB; ranksep=0.18;
n0[shape=plain,style="",label=<<table border="0" cellspacing="0" cellpadding="6" width="560"><tr><td bgcolor="#1e3a8a" width="560"><font color="white"><b>LAYER 1 — PERIMETER &amp; TRANSPORT SECURITY</b></font></td></tr><tr><td bgcolor="#f8fafc" width="560"><font point-size="10">TLS 1.3 / mutual TLS in transit · WAF, DDoS protection, API rate limiting</font></td></tr></table>>];
n1[shape=plain,style="",label=<<table border="0" cellspacing="0" cellpadding="6" width="560"><tr><td bgcolor="#1d4ed8" width="560"><font color="white"><b>LAYER 2 — IDENTITY, AUTHENTICATION &amp; ACCESS CONTROL</b></font></td></tr><tr><td bgcolor="#f8fafc" width="560"><font point-size="10">OAuth 2.0 / JWT verification (HS256 in prototype; RS256/ES256 in production) · RBAC, least privilege</font></td></tr></table>>];
n2[shape=plain,style="",label=<<table border="0" cellspacing="0" cellpadding="6" width="560"><tr><td bgcolor="#0369a1" width="560"><font color="white"><b>LAYER 3 — TRANSACTION INTEGRITY &amp; REPLAY DEFENCE</b></font></td></tr><tr><td bgcolor="#f8fafc" width="560"><font point-size="10">Schema + settlement verification · transactionID idempotency lock (409) · customer-to-meter ownership binding (403)</font></td></tr></table>>];
n3[shape=plain,style="",label=<<table border="0" cellspacing="0" cellpadding="6" width="560"><tr><td bgcolor="#0f766e" width="560"><font color="white"><b>LAYER 4 — SMART METER DEVICE &amp; PROTOCOL SECURITY</b></font></td></tr><tr><td bgcolor="#f8fafc" width="560"><font point-size="10">IEC 62056 DLMS/COSEM encrypted credit commands · mutual device authentication · tamper alerts</font></td></tr></table>>];
n4[shape=plain,style="",label=<<table border="0" cellspacing="0" cellpadding="6" width="560"><tr><td bgcolor="#b45309" width="560"><font color="white"><b>LAYER 5 — DATA, AUDIT &amp; GOVERNANCE MONITORING</b></font></td></tr><tr><td bgcolor="#f8fafc" width="560"><font point-size="10">AES-256 at rest, HSM key vault · append-only audit log, SIEM alerts · RACI / SLA governance</font></td></tr></table>>];
n0 -> n1 -> n2 -> n3 -> n4;}